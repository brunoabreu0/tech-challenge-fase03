APP_ENV=development
RANDOM_SEED=42

# --- Data Paths ---
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
MODEL_DIR=models

# --- Model Config ---
MODEL_NAME=tfidf_lr
# Options: tfidf_lr | onnx

# --- API Config ---
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# --- AWS (only for CI/CD and production) ---
AWS_DEFAULT_REGION=sa-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Kaggle (habilita download automático do dataset em runtime) ---
# Token no formato KGAT_*** — obtenha em: https://www.kaggle.com/settings > API > Create New Token
# KAGGLE_API_TOKEN=KGAT_***
